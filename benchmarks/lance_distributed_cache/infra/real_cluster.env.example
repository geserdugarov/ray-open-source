# Copy to real_cluster.env, then edit. All commands run from the build machine.
SSH_USER=ubuntu
COORD_IP=10.42.0.10
ACTOR0_IP=10.42.0.11
ACTOR1_IP=10.42.0.12
MINIO_HOST=10.42.0.20

# Optional SSH aliases, independent of the routable IPs above:
# COORD_SSH_HOST=ray-head
# ACTOR0_SSH_HOST=ray-worker-0
# ACTOR1_SSH_HOST=ray-worker-1
# MINIO_SSH_HOST=minio

# Use a real, writable local disk at the same path on both workers.
NVME_DIR=/mnt/nvme/lance-cache-bench
PYTHON_BIN=python3.12

# Defaults are relative to this benchmark or the remote user's home.
# WHEELHOUSE=/absolute/local/path/to/wheelhouse
# Regular wheel from `maturin build`, not an editable wheel from uv's cache.
# LANCE_WHEEL=/absolute/local/path/to/lance-open-source/python/dist/cluster/pylance-12.0.0-....whl
# RAY_WHEEL=/absolute/local/path/to/ray-2.58.0-....whl
# LANCE_BUILD_COMMIT=<commit used to build LANCE_WHEEL>
# REMOTE_HOME=/home/ubuntu
# REMOTE_BENCH_DIR=/home/ubuntu/git/ray-open-source/benchmarks/lance_distributed_cache
# REMOTE_WHEELHOUSE=/home/ubuntu/wheelhouse-lance12
# ENDPOINT_URL=http://10.42.0.20:9000
# MINIO_IMAGE=registry.example.com/minio:known-working-tag
# LOCAL_LOG_DIR=/absolute/local/path/to/console-logs
